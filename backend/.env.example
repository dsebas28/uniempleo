PORT=5000
# Base de datos PostgreSQL (crea antes la base y el usuario, ver README)
DATABASE_URL=postgresql://uniempleo:uniempleo@localhost:5432/uniempleo
# Genera un secreto propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
